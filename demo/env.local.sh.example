# Copy to demo/env.local.sh (gitignored) and `source` it before running the demo.
# Local-only — NEVER commit real hostnames/ids.

# The governed MCP endpoint the demo agent hits (Flex Gateway route + /mcp).
export S1_GW_URL="https://<omni-gw-small-public-host>/tri-screen-demo/mcp"

# OPTIONAL — the raw upstream A2D mock (no gateway), for the before/after contrast.
# When set, the agent shows the SAME tools/call with and without S1 screening.
export S1_RAW_URL="https://www.a2d-ai.com/api/platform/<a2d-mock-server-id>/mcp"

# --- The demo judge needs NO credentials -------------------------------------
# S1 runs with jevProvider=mock + allowMock=true (deterministic in-policy judge),
# so there is no Jev/LLM key to set here. To demo against a real System-One judge,
# set jevProvider + jevApiKey in demo/config.json instead (see config.json.example).
